@startuml
title Class Diagram - Database Models

skinparam class {
    BackgroundColor wheat
    ArrowColor Coral
}

class Role {
  +id:int
  +role_name:string
  +description:string (nullable)
}

class User {
  +id:int
  +role_id:int
  +name:string(16)
  +email:string(100)
  +password:string (hashed)
  +recovery_email:string (nullable)
  +email_verified_at:datetime (nullable)
}

class Category {
  +categoryId:int
  +categoryName:string(100)
  +categoryDescription:string(500, nullable)
}

class Product {
  +productId:int
  +categoryId:int
  +name:string(255)
  +description:string(255, nullable)
  +price:float
  +tag:string(255, nullable)
  +active:boolean
}

class Publication {
  +publicationId:int
  +rating:float
  +publicationDate:datetime
  +userId:int
  +productId:int
  +numberOfLikes:int
  +active:boolean
  +review:text (nullable)
}

class Comment {
  +id:int
  +content:text
  +userId:int
  +publicationId:int
}

class PublicationLike {
  +id:int
  +userId:int
  +publicationId:int
}

class Agenda {
  +id:int
  +user_id:int
  +reason:string
  +scheduled_date:datetime
  +phone:string
  +active:boolean
}

Role "1" -- "0..*" User : assigned to
Category "1" -- "0..*" Product : contains
Product "1" -- "0..*" Publication : appears in
User "1" -- "0..*" Publication : publishes
User "1" -- "0..*" Comment : writes
Publication "1" -- "0..*" Comment : has
User "1" -- "0..*" PublicationLike : likes
Publication "1" -- "0..*" PublicationLike : liked by
User "1" -- "0..*" Agenda : schedules

@enduml
